always @(gpio_pad_drv) if (gpio_pad_forced) gpio_pad_apply;

task gpio_pad_force_all;
begin
    gpio_pad_forced = 1'b1;
    gpio_pad_apply;
end
endtask

task gpio_pad_release_all;
begin
    gpio_pad_forced = 1'b0;
    release test_chip_top.XLSYNC3;
